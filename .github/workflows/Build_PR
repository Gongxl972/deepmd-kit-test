name: Build Cache for PR Testing

on:
  pull_request:
    types: [opened, reopened, labeled, unlabeled, synchronize]
  merge_group:
  workflow_dispatch:

jobs:
  build-wheel:
    runs-on: ubuntu-22.04
    strategy:
      matrix:
        python-version: ["3.10"]  # 与 test_PR.yml 保持一致
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
          cache: "pip"

      - name: Install uv
        run: python -m pip install uv

      - name: Install build dependencies
        run: |
          uv pip install --system --group pin_pytorch_cpu --torch-backend cpu --prerelease=allow

      - name: Build deepmd-kit wheel from source
        run: |
          # 编译并生成 wheel
          uv pip install --system -e . \
            --no-binary deepmd-kit \
            --group pin_tensorflow_cpu \
            --group pin_pytorch_cpu \
            --torch-backend cpu \
            --prerelease=allow
          python -m build --wheel --outdir dist/

      - name: Upload wheel as artifact
        uses: actions/upload-artifact@v4
        with:
          name: cached-wheel-py${{ matrix.python-version }}
          path: dist/*.whl
          retention-days: 7  # 保留7天，过期自动清理
